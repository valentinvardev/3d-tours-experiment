// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
    provider = "prisma-client-js"
    output   = "../generated/prisma"
}

datasource db {
    provider = "sqlite"
    url      = env("DATABASE_URL")
}

model Floor {
    id            String   @id @default(cuid())
    name          String
    order         Int      @default(0)
    mapImagePath  String?
    mapWidth      Int?
    mapHeight     Int?
    createdAt     DateTime @default(now())
    updatedAt     DateTime @updatedAt
    rooms         Room[]
}

model Room {
    id            String    @id @default(cuid())
    name          String
    floorId       String
    floor         Floor     @relation(fields: [floorId], references: [id], onDelete: Cascade)
    panoramaPath  String?
    cubemapPaths  String?
    boxX          Float?
    boxY          Float?
    boxWidth      Float?
    boxHeight     Float?
    defaultYaw    Float?
    defaultPitch  Float?
    isStart       Boolean   @default(false)
    createdAt     DateTime  @default(now())
    updatedAt     DateTime  @updatedAt

    hotspotsFrom  Hotspot[] @relation("FromRoom")
    hotspotsTo    Hotspot[] @relation("ToRoom")

    @@index([floorId])
}

model Hotspot {
    id          String   @id @default(cuid())
    fromRoomId  String
    toRoomId    String
    yaw         Float
    pitch       Float
    label       String?
    createdAt   DateTime @default(now())

    fromRoom    Room     @relation("FromRoom", fields: [fromRoomId], references: [id], onDelete: Cascade)
    toRoom      Room     @relation("ToRoom",   fields: [toRoomId],   references: [id], onDelete: Cascade)

    @@index([fromRoomId])
    @@index([toRoomId])
}
